#!/home/ed/.venvs/know/bin/python
import argparse, contextlib, datetime, fcntl, json, os, re, sys, tempfile, time

directory = os.environ.get('KNOW_DIR') or os.path.expanduser('~/.know')
model_path = os.path.expanduser('~/models/arctic-embed-xs')
line = '#{} {} {}'.format
model = None
minimum_similarity = 0.60
stop_words = set('a about an and are as at be by can current did do does for from get had has have how i in is it its me my name of on or our should that the their there these this to use using was we were what when where which who why will with would you your'.split())


def embed(texts):
    global model
    import numpy, onnxruntime, tokenizers
    if model is None:
        tokenizer = tokenizers.Tokenizer.from_file(model_path + '/tokenizer.json')
        tokenizer.enable_truncation(288)
        tokenizer.enable_padding()
        options = onnxruntime.SessionOptions()
        options.intra_op_num_threads = 4
        model = tokenizer, onnxruntime.InferenceSession(model_path + '/model.onnx', options, providers=['CPUExecutionProvider'])
    tokenizer, session = model
    batch = tokenizer.encode_batch(texts)
    inputs = {'input_ids': [x.ids for x in batch], 'attention_mask': [x.attention_mask for x in batch], 'token_type_ids': [x.type_ids for x in batch]}
    vectors = session.run(None, {i.name: numpy.array(inputs[i.name], 'int64') for i in session.get_inputs()})[0][:, 0]
    return [json.dumps(v.tolist(), separators=(',', ':')) for v in vectors / numpy.linalg.norm(vectors, axis=1, keepdims=True)]


def unique_fields(pairs):
    record = dict(pairs)
    if len(record) != len(pairs):
        raise ValueError('duplicate JSON field')
    return record


def read_journal(path):
    records = {}
    if not os.path.exists(path):
        return records
    with open(path, encoding='utf-8', newline='') as source:
        for number, raw in enumerate(source, 1):
            try:
                if not raw.endswith('\n'):
                    raise ValueError('incomplete final record; preserve the journal and inspect this line')
                if raw.startswith('#'):
                    match = re.fullmatch(r'#(\d+) (\d{4}-\d{2}-\d{2}) (.+)\n', raw)
                    if match is None:
                        raise ValueError('malformed legacy record')
                    record = {'i': int(match[1]), 'd': match[2], 't': match[3], 'k': 'f', 'x': []}
                else:
                    record = json.loads(raw, object_pairs_hook=unique_fields)
                # i id, d date, t text, k kind (a activity/f fact), x replaced note IDs.
                if not isinstance(record, dict) or set(record) != {'i', 'd', 't', 'k', 'x'}:
                    raise ValueError('expected record fields i,d,t,k,x')
                if type(record['i']) is not int or record['i'] < 0:
                    raise ValueError('invalid note ID')
                if not isinstance(record['d'], str) or datetime.date.fromisoformat(record['d']).isoformat() != record['d']:
                    raise ValueError('invalid date')
                if not isinstance(record['t'], str) or not record['t'].strip() or '\n' in record['t'] or '\r' in record['t']:
                    raise ValueError('invalid note text')
                if record['k'] not in ('a', 'f'):
                    raise ValueError('invalid note kind')
                if not isinstance(record['x'], list) or any(type(i) is not int or not 0 <= i < record['i'] for i in record['x']):
                    raise ValueError('replacements must name earlier note IDs')
                if len(set(record['x'])) != len(record['x']):
                    raise ValueError('duplicate replacement ID')
                if record['i'] in records and records[record['i']] != record:
                    raise ValueError(f'conflicting duplicate ID #{record["i"]}; no record was discarded')
                records[record['i']] = record
            except (ValueError, TypeError) as error:
                raise ValueError(f'{path}:{number}: {error}') from error
    for record in records.values():
        if any(i not in records for i in record['x']):
            raise ValueError(f'{path}: #{record["i"]} replaces an unknown note')
    return records


@contextlib.contextmanager
def locked():
    os.makedirs(directory, mode=0o700, exist_ok=True)
    with open(directory + '/lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


@contextlib.contextmanager
def index(path):
    import turso
    for attempt in range(180):
        connection = None
        try:
            connection = turso.connect(path)
            cursor = connection.cursor()
            # n = disposable index: i id, d date, t text, e embedding.
            cursor.execute('CREATE TABLE IF NOT EXISTS n (i INTEGER PRIMARY KEY, d TEXT NOT NULL, t TEXT NOT NULL, e BLOB)')
            break
        except turso.DatabaseError as error:
            if connection is not None:
                connection.close()
            # Turso's file lock can outlive close() until the preceding CLI exits.
            if 'Locking error' not in str(error) or attempt == 179:
                raise
            time.sleep(0.05)
    try:
        yield connection, cursor
    finally:
        connection.close()


def rows(cursor, sql, *arguments):
    cursor.execute(sql, arguments)
    return cursor.fetchall()


def insert(cursor, record):
    cursor.execute('INSERT INTO n (i, d, t) VALUES (?, ?, ?)', (record['i'], record['d'], record['t']))


@contextlib.contextmanager
def store():
    with locked():
        records = read_journal(directory + '/log')
        with index(directory + '/db') as (connection, cursor):
            indexed = rows(cursor, 'SELECT i, d, t FROM n')
            if indexed and not os.path.isfile(directory + '/log'):
                raise ValueError('journal is missing; preserve the database and restore the journal before continuing')
            for i, date, text in indexed:
                if i not in records or (date, text) != (records[i]['d'], records[i]['t']):
                    raise ValueError(f'index differs from journal at #{i}; run know rebuild')
            missing = records.keys() - {i for i, _, _ in indexed}
            if missing:
                with open(directory + '/log', 'rb') as journal:
                    os.fsync(journal.fileno())
                sync_directory()
            for i in sorted(missing):
                insert(cursor, records[i])
            connection.commit()
            yield connection, cursor, records, len(missing)


def sync_directory():
    descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def append(records):
    created = not os.path.exists(directory + '/log')
    try:
        with open(directory + '/log', 'a', encoding='utf-8') as journal:
            for record in records:
                journal.write(json.dumps(record, ensure_ascii=False, separators=(',', ':')) + '\n')
            journal.flush()
            os.fsync(journal.fileno())
        if created:
            sync_directory()
    except OSError as error:
        raise RuntimeError(f'journal persistence is uncertain; run know doctor before retrying: {error}') from error


def current_facts(records):
    replaced = {i for record in records.values() for i in record['x']}
    return {i for i, record in records.items() if record['k'] == 'f' and i not in replaced}


def words(text):
    return set(re.findall(r'[a-z0-9]+', text.casefold())) - stop_words


def display(record, replaced=None):
    return line(record['i'], record['d'], record['t']) + (' [activity]' if replaced is not None and record['k'] == 'a' else '') + (' [replaced]' if replaced is not None and record['i'] in replaced else '')


def save(connection, cursor, records, arguments):
    text = ' '.join(' '.join(arguments.a).split())
    if not 0 < len(text) <= 280:
        raise ValueError(f'the note has {len(text)} chars; the limit is 280')
    if len(set(arguments.replaces)) != len(arguments.replaces) or any(i not in records for i in arguments.replaces):
        raise ValueError('--replaces must name distinct existing note IDs')
    record = {'i': max(records, default=-1) + 1, 'd': datetime.date.today().isoformat(), 't': text, 'k': arguments.kind[0], 'x': arguments.replaces}
    append([record])
    try:
        insert(cursor, record)
        connection.commit()
    except Exception as error:
        raise RuntimeError(f'#{record["i"]} is saved in the journal; the next command will replay it: {error}') from error
    return record['i']


def note(arguments):
    with store() as (connection, cursor, records, _):
        print(f'#{save(connection, cursor, records, arguments)}')


def start(arguments):
    with store() as (connection, cursor, records, _):
        replaced = {i for record in records.values() for i in record['x']}
        # Print the newest notes from before this save so the new note does not take a slot.
        for i in sorted(records)[-arguments.n:]:
            print(display(records[i], replaced))
        print(f'saved #{save(connection, cursor, records, arguments)}')


def ask(arguments):
    vector = embed(['Represent this sentence for searching relevant passages: ' + ' '.join(arguments.a)])[0]
    with store() as (connection, cursor, records, _):
        eligible = current_facts(records)
        pending = [(i, text) for i, text in rows(cursor, 'SELECT i, t FROM n WHERE e IS NULL ORDER BY i') if i in eligible]
        if len(pending) > 36:
            print(f'know: embedding {len(pending)} facts', file=sys.stderr)
        for offset in range(0, len(pending), 36):
            batch = pending[offset:offset + 36]
            for (i, _), embedding in zip(batch, embed([text for _, text in batch])):
                cursor.execute('UPDATE n SET e = vector32(?) WHERE i = ?', (embedding, i))
            connection.commit()
        query_words = words(' '.join(arguments.a))
        matches = []
        for i, distance in rows(cursor, 'SELECT i, vector_distance_cos(e, vector32(?)) AS d FROM n WHERE e IS NOT NULL ORDER BY d, i DESC', vector):
            if i in eligible and 1 - distance >= minimum_similarity and query_words & words(records[i]['t']):
                matches.append((i, 1 - distance))
        for i, score in matches[:arguments.n]:
            print(f'{display(records[i])} [similarity {score:.3f}]')
        if not matches:
            print(f'know: no strong match (minimum similarity {minimum_similarity:g}); verify another source')


def grep(arguments):
    expression = re.compile(' '.join(arguments.a), re.I)
    with store() as (_, _, records, _):
        replaced = {i for record in records.values() for i in record['x']}
        matches = [display(records[i], replaced) for i in sorted(records) if expression.search(display(records[i]))]
    for match in matches[-arguments.n:]:
        print(match)
    if len(matches) > arguments.n:
        print(f'know: {len(matches)} notes match; these are the newest {arguments.n}', file=sys.stderr)


def doctor(arguments):
    with store() as (_, cursor, records, replayed):
        result = rows(cursor, 'PRAGMA integrity_check')
        if result != [('ok',)]:
            raise ValueError(f'index integrity check failed: {result}; run know rebuild')
        eligible = current_facts(records)
        print(f'ok: {len(records)} notes, {len(eligible)} current facts, {sum(r["k"] == "a" for r in records.values())} activity; replayed {replayed}')


def rebuild(arguments):
    with locked():
        records = read_journal(directory + '/log')
        if not os.path.isfile(directory + '/log'):
            raise ValueError('journal is missing; rebuild refused')
        descriptor, temporary = tempfile.mkstemp(prefix='.db-rebuild-', dir=directory)
        os.close(descriptor)
        try:
            with index(temporary) as (connection, cursor):
                for i in sorted(records):
                    insert(cursor, records[i])
                connection.commit()
                if rows(cursor, 'PRAGMA integrity_check') != [('ok',)] or rows(cursor, 'SELECT count(*) FROM n')[0][0] != len(records):
                    raise ValueError('replacement index failed validation')
                if rows(cursor, 'PRAGMA wal_checkpoint(TRUNCATE)')[0][0] != 0:
                    raise ValueError('replacement index checkpoint failed')
            with open(temporary, 'rb') as database:
                os.fsync(database.fileno())
            # The old WAL is also disposable; never apply it to the new index.
            for suffix in ('-wal', '-shm'):
                if os.path.exists(directory + '/db' + suffix):
                    os.unlink(directory + '/db' + suffix)
            os.replace(temporary, directory + '/db')
            sync_directory()
        finally:
            for path in (temporary, temporary + '-wal'):
                if os.path.exists(path):
                    os.unlink(path)
    print(f'rebuilt {len(records)} notes; journal unchanged; facts will embed on the next ask')


def positive_int(value):
    if int(value) < 1:
        raise argparse.ArgumentTypeError('must be positive')
    return int(value)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(prog='know')
    commands = parser.add_subparsers(dest='c', required=True)
    for name, function, word, count in (('ask', ask, 'question', 9), ('grep', grep, 'regex', 18), ('note', note, 'text', 0), ('start', start, 'text', 18), ('doctor', doctor, '', 0), ('rebuild', rebuild, '', 0)):
        command = commands.add_parser(name)
        command.set_defaults(f=function)
        if word:
            command.add_argument('a', nargs='+', metavar=word)
        if count:
            command.add_argument('-n', type=positive_int, default=count)
        if name in ('note', 'start'):
            command.add_argument('--kind', choices=('fact', 'activity'), default='activity' if name == 'start' else 'fact')
            command.add_argument('--replaces', type=int, action='append', default=[], metavar='ID')
    arguments = parser.parse_args()
    arguments.f(arguments)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        sys.exit(f'know: {type(error).__name__}: {error}')
