#!/usr/bin/env bash
set -euo pipefail
# Firecrawl CLI — search + live fetch. Reuses condense's firecrawl.py backend.
# usage: fc search "<q>" [num] [text_max]
#        fc fetch "<url>" [text_max]
ROOT="$(cd "$HOME/.agents/skills/condense-search" && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 - "$@" <<'PY'
import sys
from cnd import firecrawl

def main():
    if not firecrawl.available():
        sys.stderr.write("no FIRECRAWL_API_KEY (set ~/.agents/secrets/firecrawl.env)\n")
        sys.exit(1)
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "search":
        q = sys.argv[2] if len(sys.argv) > 2 else ""
        num = int(sys.argv[3]) if len(sys.argv) > 3 else 8
        tmax = int(sys.argv[4]) if len(sys.argv) > 4 else 8000
        rows = firecrawl.search(q, num_results=num)
        urls = [r["url"] for r in rows if r.get("url")]
        contents, statuses = firecrawl.contents(urls, text_max=tmax)
        by_url = {c.get("url"): c for c in contents}
        for r in rows:
            c = by_url.get(r.get("url"), {})
            print(f"## {r.get('title') or ''}\n{r.get('url')}\n{(c.get('text') or '')[:tmax]}\n")
    elif cmd == "fetch":
        u = sys.argv[2] if len(sys.argv) > 2 else ""
        tmax = int(sys.argv[3]) if len(sys.argv) > 3 else 15000
        res, _ = firecrawl.contents([u], text_max=tmax)
        if res:
            print((res[0].get("text") or "")[:tmax])
    else:
        sys.stderr.write("usage: fc search <q> [num] [text_max] | fc fetch <url> [text_max]\n")
        sys.exit(1)

main()
PY
